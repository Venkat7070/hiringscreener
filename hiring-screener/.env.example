# Postgres connection string (Vercel Postgres / Neon). Auto-populated when you
# provision a Vercel Postgres database and link the project with `vercel env pull`.
DATABASE_URL=

# Groq API key, used for AI scoring (open-weight models, high rate limits).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: overrides the Groq model id. Defaults to llama-3.1-8b-instant.
GROQ_MODEL=

# Password required to access /admin. Keep this secret.
ADMIN_PASSWORD=

# Vercel Blob read/write token. Auto-populated when you provision a Blob store
# and link the project with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Unipile API key, from your Unipile dashboard (after connecting your LinkedIn
# account). Used to fetch message attachments.
UNIPILE_API_KEY=

# Unipile DSN — the base URL for your Unipile account, e.g.
# https://api6.unipile.com:13443 (shown in the Unipile dashboard).
UNIPILE_DSN=

# Shared secret you choose yourself. Set the same value as a custom
# "X-Webhook-Secret" header when you register the Unipile webhook — the
# /api/linkedin/webhook route rejects any request that doesn't match.
LINKEDIN_WEBHOOK_SECRET=
