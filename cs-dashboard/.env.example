# --- Google Sheets service account (leave unset to use sample data instead) ---
# Email of the GCP service account that has been shared on the sheet as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=cs-dashboard@your-project.iam.gserviceaccount.com

# Private key from the service account's JSON key file, "private_key" field.
# Paste it as a single line with literal \n for newlines (the app un-escapes
# them). Keep the surrounding quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Tab name containing the account data. Defaults to "Data" if unset.
SHEET_TAB=Data

# --- Local development without Google credentials ---
# Set to "true" to always read from sample-data.csv instead of the Sheets API,
# regardless of the variables above. Useful for local dev / demos.
USE_SAMPLE_DATA=true

# --- App access (HTTP Basic Auth) ---
# If either is unset, auth is disabled (open access) — do not deploy without
# setting both. See README for upgrading to Google OAuth.
DASHBOARD_USER=
DASHBOARD_PASS=
