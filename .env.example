# Get your key from https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# Optional overrides
SUPPORT_BOT_MODEL=llama-3.3-70b-versatile

# Only set PORT for local dev if you want a port other than 3000.
# Do NOT set this on Render — it assigns its own PORT and expects the
# app to bind to that; overriding it breaks Render's port detection.
PORT=3000

# Required to receive WhatsApp messages via Twilio's webhook.
# Find it at https://console.twilio.com (Account Info panel).
# If unset, the /webhook/whatsapp route skips signature verification —
# fine for local testing, do not leave it unset in production.
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
